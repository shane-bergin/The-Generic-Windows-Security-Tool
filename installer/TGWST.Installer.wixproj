<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{E1E4C6C7-B5A3-4F22-B1AC-28F3550E1A2C}</ProjectGuid>
    <OutputName>TGWST.Setup</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <WixTargetsPath Condition=" '$(WixTargetsPath)' == '' and Exists('$(MSBuildExtensionsPath)\Microsoft\WiX\v3.x\Wix.targets') ">$(MSBuildExtensionsPath)\Microsoft\WiX\v3.x\Wix.targets</WixTargetsPath>
    <WixTargetsPath Condition=" '$(WixTargetsPath)' == '' and Exists('$(ProgramFiles(x86))\WiX Toolset v3.11\bin\Wix.targets') ">$(ProgramFiles(x86))\WiX Toolset v3.11\bin\Wix.targets</WixTargetsPath>
    <WixTargetsPath Condition=" '$(WixTargetsPath)' == '' and Exists('$(ProgramFiles)\WiX Toolset v3.11\bin\Wix.targets') ">$(ProgramFiles)\WiX Toolset v3.11\bin\Wix.targets</WixTargetsPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TGWST.Installer.wxs" />
  </ItemGroup>
  <ItemGroup>
    <WixExtension Include="WixUIExtension" />
    <WixExtension Include="WixUtilExtension" />
  </ItemGroup>
  <Target Name="Build" Condition=" !Exists('$(WixTargetsPath)') ">
    <Error Text="WiX Toolset v3.11 is required to build installer/TGWST.Installer.wixproj. Install WiX v3.11 or run installer/build-msi.ps1 with WIX_BIN set to your WiX bin path." />
  </Target>
  <Import Project="$(WixTargetsPath)" Condition=" Exists('$(WixTargetsPath)') " />
</Project>
