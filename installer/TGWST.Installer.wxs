<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="TGWST - Windows Security Tool" Language="1033" Version="$(var.ProductVersion)" Manufacturer="Shane Bergin" UpgradeCode="BE64B133-8D56-45A3-9C7E-5F89A0A3CC01">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A later version of TGWST is already installed."
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallValidate" />
    <MediaTemplate EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <Property Id="ARPHELPLINK" Value="https://github.com/shane-bergin/The-Generic-Windows-Security-Tool" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="TGWST - Windows 11 Security Hardening, Compliance, Scan Tool" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="TGWST" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="The Generic Windows Security Tool" />
      </Directory>
      <Directory Id="DesktopFolder" />
      <Directory Id="CommonAppDataFolder">
        <Directory Id="TGWSTAppData" Name="TGWST">
          <Directory Id="BaselinesDir" Name="Baselines" />
          <Directory Id="WdacDataDir" Name="WDAC" />
          <Directory Id="ModelsDir" Name="Models" />
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="The Generic Windows Security Tool" Level="1">
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="AppIconFile" />
      <ComponentRef Id="BaselineFile" />
      <ComponentRef Id="WdacDataFolder" />
      <ComponentRef Id="RemoveAppDataDir" />
      <ComponentRef Id="RemoveInstallDir" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch The Generic Windows Security Tool" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction Id="LaunchApplication"
                  Directory="INSTALLFOLDER"
                  ExeCommand="[INSTALLFOLDER]$(var.AppExeName)"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize">
        WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed
      </Custom>
    </InstallExecuteSequence>
  </Product>

  <Fragment>
    <Icon Id="AppIcon" SourceFile="$(var.IconPath)" />
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppIconFile" Guid="*" Win64="yes">
        <File Id="AppIconFile" Source="$(var.IconPath)" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ProgramMenuDir">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="TGWSTShortcut"
                  Name="The Generic Windows Security Tool"
                  Target="[INSTALLFOLDER]$(var.AppExeName)"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="The Generic Windows Security Tool"
                  Icon="AppIcon" />
        <RemoveFolder Id="ProgramMenuDirRemove" Directory="ProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\TGWST" Name="Installed" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="TGWSTDesktopShortcut"
                  Name="TGWST"
                  Target="[INSTALLFOLDER]$(var.AppExeName)"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="The Generic Windows Security Tool"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\TGWST" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="BaselinesDir">
      <Component Id="BaselineFile" Guid="*">
        <File Id="TGWST_Balanced.csv" Source="..\assets\Baselines\TGWST_Balanced.csv" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="WdacDataDir">
      <Component Id="WdacDataFolder" Guid="A21A46F1-5D62-47B4-A6C2-38B5AD2B8978" NeverOverwrite="yes" Win64="yes" KeyPath="yes">
        <CreateFolder />
        <RemoveFolder Id="RemoveWdacDataDir" On="uninstall" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="TGWSTAppData">
      <Component Id="RemoveAppDataDir" Guid="*">
        <RemoveFolder Id="RemoveTGWSTAppData" On="uninstall" Directory="TGWSTAppData" />
        <RegistryValue Root="HKCU" Key="Software\TGWST" Name="Cleanup" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="RemoveInstallDir" Guid="*" Win64="yes">
        <RemoveFolder Id="RemoveTGWSTInstallDir" On="uninstall" Directory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\TGWST" Name="Cleanup" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
