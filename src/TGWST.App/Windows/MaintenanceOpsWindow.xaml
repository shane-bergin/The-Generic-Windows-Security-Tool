<Window x:Class="TGWST.App.Windows.MaintenanceOpsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TGWST.App.Converters"
        Title="TGWST - Maintenance Operations"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="680"
        Background="#1A1F2B"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#21293A" />
        <SolidColorBrush x:Key="Panel2" Color="#1D2535" />
        <SolidColorBrush x:Key="Line" Color="#3C4C68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DEE7F6" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A4C1" />
        <SolidColorBrush x:Key="Green" Color="#8ED26D" />
        <SolidColorBrush x:Key="Amber" Color="#D9BA70" />
        <SolidColorBrush x:Key="Red" Color="#E16E74" />
        <SolidColorBrush x:Key="Blue" Color="#64A7E2" />
        <SolidColorBrush x:Key="Cyan" Color="#7EC7FF" />
        <SolidColorBrush x:Key="Magenta" Color="#A89AE0" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="TerminalDataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="#1A2232" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#1E2637" />
            <Setter Property="AlternatingRowBackground" Value="#23304A" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="HorizontalGridLinesBrush" Value="#344866" />
            <Setter Property="VerticalGridLinesBrush" Value="#344866" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
        </Style>

        <Style x:Key="TerminalDataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#243249" />
            <Setter Property="Foreground" Value="{StaticResource Cyan}" />
            <Setter Property="BorderBrush" Value="#4F6483" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,3,6,3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TerminalDataGridCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#344866" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="5,2,5,2" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#F7FBFF" />
                    <Setter Property="Background" Value="#33507A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TerminalDataGridRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B3D5D" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33507A" />
                    <Setter Property="Foreground" Value="#F7FBFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource Cyan}"
                               Text="[MAINTENANCE OPERATIONS CENTER]" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="9"
                               Foreground="{StaticResource TextMuted}"
                               Text="Deleted recovery | services analyzer | temp/appdata junk | event log analyzer" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="110"
                            Margin="0,0,6,0"
                            Content="Cancel Active"
                            IsEnabled="{Binding HasActiveOperation}"
                            Click="CancelActive_Click" />
                    <Button Width="84"
                            Content="Close"
                            Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="0,6,0,0"
                    Background="{StaticResource Panel2}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1">
            <TabItem Header="Recovery">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="6,4"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource TextMuted}" Text="Source drive:" />
                                <TextBox Width="52"
                                         Margin="0,0,10,0"
                                         Padding="4,1"
                                         FontSize="9"
                                         Text="{Binding RecoverySourceDrive, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource TextMuted}" Text="Recovery folder:" />
                                <TextBox Width="340"
                                         Margin="0,0,6,0"
                                         Padding="4,1"
                                         FontSize="9"
                                         Text="{Binding RecoveryDestinationRoot, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Width="72"
                                        Margin="0,0,10,0"
                                        Content="Browse"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Click="BrowseRecoveryFolder_Click" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Width="84"
                                        Margin="0,0,6,0"
                                        Content="Scan"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Click="RecoveryScan_Click" />
                                <Button Width="84"
                                        Margin="0,0,6,0"
                                        Content="Preview"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Click="RecoveryPreview_Click" />
                                <Button Width="84"
                                        Content="Restore"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Click="RecoveryRestore_Click" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="4"
                            Background="#1A2232"
                            BorderBrush="#3F5472"
                            BorderThickness="1">
                        <DataGrid ItemsSource="{Binding RecoveryItems}"
                                  SelectedItem="{Binding SelectedRecoveryItem}"
                                  Style="{StaticResource TerminalDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource TerminalDataGridHeaderStyle}"
                                  CellStyle="{StaticResource TerminalDataGridCellStyle}"
                                  RowStyle="{StaticResource TerminalDataGridRowStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" SortMemberPath="FileName" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding FileType}" SortMemberPath="FileType" Width="80" />
                                <DataGridTextColumn Header="Size" Binding="{Binding FileSizeDisplay}" SortMemberPath="FileSize" Width="120" />
                                <DataGridTextColumn Header="Date Modified" Binding="{Binding DateModified}" SortMemberPath="DateModified" Width="180" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,6,0,0"
                            Padding="6"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Margin="0,0,6,0"
                                     FontSize="9"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="#1A2232"
                                     BorderBrush="#3F5472"
                                     BorderThickness="1"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding RecoveryPreviewText}" />

                            <Border Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Background="#1A2232"
                                    BorderBrush="#3F5472"
                                    BorderThickness="1"
                                    Visibility="{Binding ShowRecoveryImagePreview, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding RecoveryPreviewImagePath}" Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Services">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="6,4"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Width="92" Margin="0,0,6,0" Content="Analyze" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="AnalyzeServices_Click" />
                                <Button Width="128" Margin="0,0,6,0" Content="Disable Selected" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="DisableService_Click" />
                                <Button Width="132" Margin="0,0,10,0" Content="Re-Enable Selected" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="RestoreService_Click" />
                                <Button Width="122" Margin="0,0,10,0" Content="Inspect Selected" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="InspectService_Click" />
                                <CheckBox VerticalAlignment="Center"
                                          Foreground="{StaticResource TextPrimary}"
                                          IsChecked="{Binding ShowNonEssentialServicesOnly}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                          Content="Non-essential only" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="{Binding ServiceStatusText}" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="4"
                            Background="#1A2232"
                            BorderBrush="#3F5472"
                            BorderThickness="1">
                        <DataGrid x:Name="ServiceGrid"
                                  ItemsSource="{Binding ServiceItems}"
                                  SelectedItem="{Binding SelectedServiceItem}"
                                  MouseDoubleClick="ServiceGrid_MouseDoubleClick"
                                  Style="{StaticResource TerminalDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource TerminalDataGridHeaderStyle}"
                                  CellStyle="{StaticResource TerminalDataGridCellStyle}"
                                  RowStyle="{StaticResource TerminalDataGridRowStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service Name" Binding="{Binding ServiceName}" SortMemberPath="ServiceName" Width="155" />
                                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" SortMemberPath="DisplayName" Width="210" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="90" />
                                <DataGridTextColumn Header="Startup Type" Binding="{Binding StartupType}" SortMemberPath="StartupType" Width="105" />
                                <DataGridTextColumn Header="State Note" Binding="{Binding StateNote}" SortMemberPath="StateNote" Width="170" />
                                <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" SortMemberPath="Origin" Width="110" />
                                <DataGridCheckBoxColumn Header="Essential"
                                                        Binding="{Binding Essential, Mode=OneWay}"
                                                        IsReadOnly="True"
                                                        Width="74" />
                                <DataGridTextColumn Header="Impact" Binding="{Binding ImpactLabel}" SortMemberPath="ImpactLabel" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighImpact}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Summary"
                                                    Binding="{Binding TableSummary}"
                                                    SortMemberPath="RecommendationSummary"
                                                    Width="330">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Magenta}" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="MaxHeight" Value="32" />
                                            <Setter Property="ToolTip" Value="{Binding RecommendationSummary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighImpact}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,6,0,0"
                            Padding="6,4"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Margin="0,0,8,0"
                                     FontSize="9"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="#1A2232"
                                     BorderBrush="#3F5472"
                                     BorderThickness="1"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ServiceInspectorPreviewText}" />

                            <StackPanel Grid.Column="1">
                                <Button Width="138"
                                        Margin="0,0,0,6"
                                        Content="Inspect Selected"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Click="InspectService_Click" />
                                <TextBlock FontSize="9"
                                           Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap"
                                           Text="Double-click a row for full inspector details without crowding the table." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Junk">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="210" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="6,4"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Width="92" Margin="0,0,6,0" Content="Analyze" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="AnalyzeJunk_Click" />
                                <Button Width="116" Margin="0,0,6,0" Content="Clean Selected" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="CleanSelectedJunk_Click" />
                                <Button Width="128" Margin="0,0,6,0" Content="Clean All Safe" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="CleanAllSafeJunk_Click" />
                                <Button Width="122" Margin="0,0,10,0" Content="Inspect Selected" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="InspectJunk_Click" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="{Binding JunkStatusText}" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="4"
                            Background="#1A2232"
                            BorderBrush="#3F5472"
                            BorderThickness="1">
                        <DataGrid x:Name="JunkGrid"
                                  ItemsSource="{Binding JunkItems}"
                                  SelectedItem="{Binding SelectedJunkItem}"
                                  MouseDoubleClick="JunkGrid_MouseDoubleClick"
                                  Style="{StaticResource TerminalDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource TerminalDataGridHeaderStyle}"
                                  CellStyle="{StaticResource TerminalDataGridCellStyle}"
                                  RowStyle="{StaticResource TerminalDataGridRowStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="False"
                                  CanUserSortColumns="True"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path, Mode=OneWay}" SortMemberPath="Path" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" SortMemberPath="Kind" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay, Mode=OneWay}" SortMemberPath="SizeBytes" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastModified, Mode=OneWay}" SortMemberPath="LastModified" Width="170" IsReadOnly="True" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" SortMemberPath="Category" Width="180" IsReadOnly="True" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" SortMemberPath="Reason" Width="240" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="MaxHeight" Value="32" />
                                            <Setter Property="ToolTip" Value="{Binding Reason}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="Safe"
                                                        Binding="{Binding SafeToClean, Mode=OneWay}"
                                                        IsReadOnly="True"
                                                        Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,6,0,0"
                            Padding="6,4"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Margin="0,0,8,0"
                                     FontSize="9"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="#1A2232"
                                     BorderBrush="#3F5472"
                                     BorderThickness="1"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding JunkInspectorPreviewText}" />

                            <StackPanel Grid.Column="1">
                                <Button Width="138"
                                        Margin="0,0,0,6"
                                        Content="Inspect Selected"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Click="InspectJunk_Click" />
                                <TextBlock FontSize="9"
                                           Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap"
                                           Text="Double-click a junk row for the full inspector with cleanup guidance and safety notes." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Event Logs">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="210" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="6,4"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontSize="9"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="Lookback (days):" />
                                <ComboBox Width="72"
                                          Margin="0,0,8,0"
                                          SelectedItem="{Binding EventLookbackDays}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                          ItemsSource="{Binding EventLookbackOptions}" />
                                <Button Width="92" Margin="0,0,6,0" Content="Analyze" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="AnalyzeEvents_Click" />
                                <Button Width="122" Margin="0,0,8,0" Content="Inspect Selected" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Click="InspectEvent_Click" />
                                <CheckBox VerticalAlignment="Center"
                                          Foreground="{StaticResource TextPrimary}"
                                          IsChecked="{Binding ShowDrasticEventsOnly}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                          Content="Drastic only" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="{Binding EventStatusText}" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="4"
                            Background="#1A2232"
                            BorderBrush="#3F5472"
                            BorderThickness="1">
                        <DataGrid x:Name="EventGrid"
                                  ItemsSource="{Binding EventItems}"
                                  SelectedItem="{Binding SelectedEventItem}"
                                  MouseDoubleClick="EventGrid_MouseDoubleClick"
                                  Style="{StaticResource TerminalDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource TerminalDataGridHeaderStyle}"
                                  CellStyle="{StaticResource TerminalDataGridCellStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  BorderThickness="0">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource TerminalDataGridRowStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDrastic}" Value="True">
                                            <Setter Property="Background" Value="#3A2730" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeCreated}" SortMemberPath="TimeCreated" Width="165" />
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" SortMemberPath="Severity" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Medium">
                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Low">
                                                    <Setter Property="Foreground" Value="{StaticResource Blue}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Importance" Binding="{Binding Importance}" SortMemberPath="Importance" Width="118">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDrastic}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Importance}" Value="Important">
                                                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Importance}" Value="Typical">
                                                    <Setter Property="Foreground" Value="{StaticResource Blue}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Event ID" Binding="{Binding EventId}" SortMemberPath="EventId" Width="78" />
                                <DataGridTextColumn Header="Log" Binding="{Binding LogName}" SortMemberPath="LogName" Width="170" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" SortMemberPath="Source" Width="150" />
                                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" SortMemberPath="Rule" Width="180" />
                                <DataGridTextColumn Header="Summary"
                                                    Binding="{Binding SummaryShort}"
                                                    SortMemberPath="Summary"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="MaxHeight" Value="32" />
                                            <Setter Property="ToolTip" Value="{Binding Summary}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" SortMemberPath="Count" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,6,0,0"
                            Padding="6,4"
                            Background="#243249"
                            BorderBrush="#4F6483"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Margin="0,0,8,0"
                                     FontSize="9"
                                     Foreground="{StaticResource TextPrimary}"
                                     Background="#1A2232"
                                     BorderBrush="#3F5472"
                                     BorderThickness="1"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding EventDetailText}" />

                            <StackPanel Grid.Column="1">
                                <Button Width="138"
                                        Margin="0,0,0,6"
                                        Content="Inspect Selected"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Click="InspectEvent_Click" />
                                <TextBlock FontSize="9"
                                           Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap"
                                           Text="Double-click an event for the full analyzer context: purpose, why it matters, and recommended action." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="{Binding FooterText}" />
                <TextBlock DockPanel.Dock="Right"
                           FontSize="9"
                           Foreground="{StaticResource Blue}"
                           Text="{Binding CurrentOperation, StringFormat='active : {0}'}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
