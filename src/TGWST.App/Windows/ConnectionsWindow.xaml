<Window x:Class="TGWST.App.Windows.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connections Monitor" Height="420" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="FilterBox" Width="220" Margin="0,0,8,0" ToolTip="Filter by address, host, or process"/>
            <Button Content="Refresh" Click="Refresh_Click" Width="80" Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
        </StackPanel>

        <DataGrid x:Name="ConnectionsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="Auto"/>
                <DataGridTextColumn Header="Local" Binding="{Binding LocalAddress}" Width="*"/>
                <DataGridTextColumn Header="Remote" Binding="{Binding RemoteAddress}" Width="*"/>
                <DataGridTextColumn Header="Remote Host" Binding="{Binding RemoteHost}" Width="*"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="Auto"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="Auto"/>
                <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="Red"/>
    </Grid>
</Window>
