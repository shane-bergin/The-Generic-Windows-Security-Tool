<Window x:Class="TGWST.App.Windows.JunkInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - Junk Inspector"
        Width="920"
        Height="640"
        MinWidth="780"
        MinHeight="540"
        Background="#1A1F2B"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#21293A" />
        <SolidColorBrush x:Key="Panel2" Color="#1D2535" />
        <SolidColorBrush x:Key="Line" Color="#3C4C68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DEE7F6" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A4C1" />
        <SolidColorBrush x:Key="Green" Color="#8ED26D" />
        <SolidColorBrush x:Key="Amber" Color="#D9BA70" />
        <SolidColorBrush x:Key="Red" Color="#E16E74" />
        <SolidColorBrush x:Key="Blue" Color="#64A7E2" />
        <SolidColorBrush x:Key="Cyan" Color="#7EC7FF" />
        <SolidColorBrush x:Key="Magenta" Color="#A89AE0" />

        <Style x:Key="SafetyStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Amber}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SafeToClean}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,6">
            <StackPanel>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource Cyan}"
                           Text="[JUNK INSPECTOR]" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="10"
                           Foreground="{StaticResource TextPrimary}"
                           Text="{Binding Kind, StringFormat=Kind: {0}}" />
                <TextBlock Margin="0,1,0,0"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="{Binding Path, StringFormat=Path: {0}}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel2}"
                Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[ITEM STATE]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding SizeDisplay, StringFormat=Size: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding LastModified, StringFormat=Modified: {0:G}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Category, StringFormat=Category: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Style="{StaticResource SafetyStyle}" Text="{Binding SafetyLabel, StringFormat=Safety: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextMuted}" Text="{Binding Importance, StringFormat=Importance: {0}}" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[ANALYZER REASON]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource Magenta}" Text="{Binding Reason, StringFormat=Reason: {0}}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[CLEANUP CONTEXT]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Purpose, StringFormat=Purpose: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource Magenta}" Text="{Binding WhyItMatters, StringFormat=Why It Matters: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontSize="10" Style="{StaticResource SafetyStyle}" Text="{Binding Recommendation, StringFormat=Recommendation: {0}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="Junk inspector provides cleanup guidance and safety context before deletion." />
                <Button DockPanel.Dock="Right"
                        Width="84"
                        Height="24"
                        Margin="8,0,0,0"
                        Content="Close"
                        Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
