<Window x:Class="TGWST.App.Windows.ServiceInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - Service Inspector"
        Width="900"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        Background="#1A1F2B"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#21293A" />
        <SolidColorBrush x:Key="Panel2" Color="#1D2535" />
        <SolidColorBrush x:Key="Line" Color="#3C4C68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DEE7F6" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A4C1" />
        <SolidColorBrush x:Key="Green" Color="#8ED26D" />
        <SolidColorBrush x:Key="Amber" Color="#D9BA70" />
        <SolidColorBrush x:Key="Red" Color="#E16E74" />
        <SolidColorBrush x:Key="Blue" Color="#64A7E2" />
        <SolidColorBrush x:Key="Cyan" Color="#7EC7FF" />
        <SolidColorBrush x:Key="Magenta" Color="#A89AE0" />

        <Style x:Key="ImpactTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HighImpact}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,6">
            <StackPanel>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource Cyan}"
                           Text="[SERVICE INSPECTOR]" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="10"
                           Foreground="{StaticResource TextPrimary}"
                           Text="{Binding ServiceName, StringFormat=Service: {0}}" />
                <TextBlock Margin="0,1,0,0"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="{Binding DisplayName, StringFormat=Display: {0}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel2}"
                Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[CURRENT STATE]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Status, StringFormat=Status: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding StartupType, StringFormat=Startup Type: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding StateNote, StringFormat=State Note: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Origin, StringFormat=Origin: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Essential, StringFormat=Essential: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Style="{StaticResource ImpactTextStyle}" Text="{Binding ImpactLabel, StringFormat=Impact: {0}}" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[BASELINE ASSESSMENT]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource Magenta}" Text="{Binding Reason, StringFormat=Reason: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Style="{StaticResource ImpactTextStyle}" Text="{Binding Recommendation, StringFormat=Recommendation: {0}}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[PURPOSE + DECISION GUIDE]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Purpose, StringFormat=Purpose: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource Green}" Text="{Binding KeepEnabledReason, StringFormat=Keep Enabled When: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource Amber}" Text="{Binding DisableReason, StringFormat=Disable When: {0}}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="Inspector shows function + keep/disable tradeoffs. High-impact recommendations are highlighted in red." />
                <Button DockPanel.Dock="Right"
                        Width="84"
                        Height="24"
                        Margin="8,0,0,0"
                        Content="Close"
                        Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
