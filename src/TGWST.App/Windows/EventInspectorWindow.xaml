<Window x:Class="TGWST.App.Windows.EventInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - Event Inspector"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        Background="#1A1F2B"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#21293A" />
        <SolidColorBrush x:Key="Panel2" Color="#1D2535" />
        <SolidColorBrush x:Key="Line" Color="#3C4C68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DEE7F6" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A4C1" />
        <SolidColorBrush x:Key="Green" Color="#8ED26D" />
        <SolidColorBrush x:Key="Amber" Color="#D9BA70" />
        <SolidColorBrush x:Key="Red" Color="#E16E74" />
        <SolidColorBrush x:Key="Blue" Color="#64A7E2" />
        <SolidColorBrush x:Key="Cyan" Color="#7EC7FF" />
        <SolidColorBrush x:Key="Magenta" Color="#A89AE0" />

        <Style x:Key="ImportanceStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDrastic}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Importance}" Value="Important">
                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Importance}" Value="Typical">
                    <Setter Property="Foreground" Value="{StaticResource Blue}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,6">
            <StackPanel>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource Cyan}"
                           Text="[EVENT INSPECTOR]" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="10"
                           Foreground="{StaticResource TextPrimary}"
                           Text="{Binding Rule, StringFormat=Rule: {0}}" />
                <TextBlock Margin="0,1,0,0"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="{Binding TimeCreated, StringFormat=Time: {0:G}}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel2}"
                Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[EVENT METADATA]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Severity, StringFormat=Severity: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Style="{StaticResource ImportanceStyle}" Text="{Binding Importance, StringFormat=Importance: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding EventId, StringFormat=Event ID: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding LogName, StringFormat=Log: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Source, StringFormat=Source: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Count, StringFormat=Occurrences: {0}}" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[SUMMARY]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[ANALYZER CONTEXT]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Purpose, StringFormat=Purpose: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource Magenta}" Text="{Binding WhyItMatters, StringFormat=Why It Matters: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" FontSize="10" Style="{StaticResource ImportanceStyle}" Text="{Binding Recommendation, StringFormat=Recommendation: {0}}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[RAW EVENT MESSAGE]" />
                        <TextBox Margin="0,4,0,0"
                                 FontSize="9"
                                 Foreground="{StaticResource TextPrimary}"
                                 Background="#1A2232"
                                 BorderBrush="#3F5472"
                                 BorderThickness="1"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding MessageDisplay}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="Event inspector provides importance, purpose, and action guidance beyond default Event Viewer context." />
                <Button DockPanel.Dock="Right"
                        Width="84"
                        Height="24"
                        Margin="8,0,0,0"
                        Content="Close"
                        Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
