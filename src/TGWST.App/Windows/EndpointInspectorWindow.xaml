<Window x:Class="TGWST.App.Windows.EndpointInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - Endpoint Inspector"
        Width="860"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        Background="#1A1F2B"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#21293A" />
        <SolidColorBrush x:Key="Panel2" Color="#1D2535" />
        <SolidColorBrush x:Key="Line" Color="#3C4C68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DEE7F6" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A4C1" />
        <SolidColorBrush x:Key="Green" Color="#8ED26D" />
        <SolidColorBrush x:Key="Amber" Color="#D9BA70" />
        <SolidColorBrush x:Key="Red" Color="#E16E74" />
        <SolidColorBrush x:Key="Blue" Color="#64A7E2" />
        <SolidColorBrush x:Key="Cyan" Color="#7EC7FF" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,6">
            <StackPanel>
                <TextBlock FontSize="10"
                           Foreground="{StaticResource Cyan}"
                           Text="[ENDPOINT ISOLATION VIEW]" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="10"
                           Foreground="{StaticResource TextPrimary}"
                           Text="{Binding EndpointDisplay, StringFormat=Target: {0}}" />
                <TextBlock Margin="0,1,0,0"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="{Binding EndpointSubline}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel2}"
                Padding="8,6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[FLOW DETAILS]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding ProcessName, StringFormat=Process: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding ProcessId, StringFormat=PID: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Protocol, StringFormat=Protocol: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding ActionText, StringFormat=Action: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource Amber}" Text="{Binding RiskToken, StringFormat=Risk: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding RiskScore, StringFormat=Risk Score: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding RiskReasons, StringFormat=Risk Signals: {0}}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[TRAFFIC]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding BytesSentDisplay, StringFormat=Bytes Out: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding BytesReceivedDisplay, StringFormat=Bytes In: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding TotalBytesDisplay, StringFormat=Total: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding FlowDurationDisplay, StringFormat=Duration: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding FirstSeenDisplay, StringFormat=First Seen: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding LastSeenDisplay, StringFormat=Last Seen: {0}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock FontSize="10" Foreground="{StaticResource Blue}" Text="[NETWORK/DNS]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding RemoteAddress, StringFormat=Remote IP: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding RemotePort, StringFormat=Remote Port: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding RemoteCountry, StringFormat=Country: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding DnsHostDisplay, StringFormat=DNS Hostname: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextMuted}" Text="{Binding DnsStatusDisplay}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextMuted}" Text="{Binding DnsEvidenceDisplay}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[LOCAL SOCKET]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding LocalAddress, StringFormat=Local IP: {0}}" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding LocalPort, StringFormat=Local Port: {0}}" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[SIGNATURE/PATH]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding ProcessSigner, StringFormat=Signer: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding ProcessPath, StringFormat=Path: {0}}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextMuted}" Text="{Binding ProcessIdentityDisplay}" TextWrapping="Wrap" />

                        <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Blue}" Text="[HISTORICAL RECORD PULL]" />
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding HistoricalRecordsDisplay}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding HistoricalActionsDisplay}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,1,0,0" FontSize="10" Foreground="{StaticResource TextMuted}" Text="{Binding RecordPullDisplay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontSize="9"
                           Foreground="{StaticResource TextMuted}"
                           Text="Live mirror of selected connection with DNS evidence and archived flow pull context." />
                <Button DockPanel.Dock="Right"
                        Width="84"
                        Height="24"
                        Margin="8,0,0,0"
                        Content="Close"
                        Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
