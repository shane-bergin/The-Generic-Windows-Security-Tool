<Window x:Class="TGWST.App.Windows.LLMSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM Settings" Height="260" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Provider:" VerticalAlignment="Center" Width="80"/>
            <ComboBox x:Name="ProviderCombo" Width="220" SelectedIndex="0">
                <ComboBoxItem Content="OpenAI" Tag="OpenAI"/>
                <ComboBoxItem Content="xAI" Tag="XAI"/>
                <ComboBoxItem Content="Gemini" Tag="Gemini"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="1">
            <TextBlock Text="API Key:" VerticalAlignment="Center" Width="80"/>
            <PasswordBox x:Name="ApiKeyBox" Width="300"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="2">
            <TextBlock Text="Model:" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="ModelBox" Width="220" ToolTip="Optional. Defaults: gpt-4o-mini (OpenAI), grok-beta (xAI), gemini-1.5-flash (Gemini)"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Grid.Row="3">
            <TextBlock Text="Endpoint:" VerticalAlignment="Center" Width="80"/>
            <TextBox x:Name="EndpointBox" Width="300" ToolTip="Optional. OpenAI/xAI style base URL (e.g., https://api.openai.com)"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="4">
            <Button Content="Save" Width="80" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
