<Window x:Class="TGWST.App.Windows.WslCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WSL Sudo Credentials"
        Height="430"
        Width="560"
        MinHeight="400"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#05080D"
        Foreground="#D8EBFF"
        FontFamily="Cascadia Mono, Consolas">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#1D3656"
                BorderThickness="1"
                CornerRadius="3"
                Background="#070C14"
                Padding="8,6">
            <StackPanel>
                <TextBlock Foreground="#1CEBFF"
                           FontSize="12"
                           Text="[WSL CREDENTIAL CACHE]" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#7F99B8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Credentials are encrypted with Windows DPAPI and used for sudo-backed WSL actions." />
            </StackPanel>
        </Border>

        <CheckBox x:Name="EnableCheck"
                  Grid.Row="1"
                  Margin="0,10,0,8"
                  Foreground="#00FF9A"
                  Content="[✓] Enable stored WSL sudo credentials for backend actions" />

        <Border Grid.Row="2"
                Margin="0,0,0,8"
                BorderBrush="#1D3656"
                BorderThickness="1"
                CornerRadius="3"
                Background="#070C14"
                Padding="8,6">
            <StackPanel>
                <TextBlock Foreground="#3FA9FF" FontSize="11" Text="[WSL ENVIRONMENT AUTO-DETECTED]" />
                <TextBlock x:Name="DetectedDistroText"
                           Margin="0,4,0,0"
                           Foreground="#D8EBFF"
                           FontSize="11"
                           Text="Distro: (probing...)" />
                <TextBlock x:Name="DetectedUserText"
                           Margin="0,2,0,0"
                           Foreground="#D8EBFF"
                           FontSize="11"
                           Text="User: (probing...)" />
                <TextBlock x:Name="DetectedKernelText"
                           Margin="0,2,0,0"
                           Foreground="#7F99B8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="Kernel: (probing...)" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#3FA9FF" Text="Linux username:" />
            <TextBox x:Name="UserBox"
                     Grid.Column="1"
                     Height="26"
                     Padding="6,2"
                     Background="#0B1E34"
                     BorderBrush="#30567E"
                     Foreground="#D8EBFF" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#3FA9FF" Text="Sudo password:" />
            <PasswordBox x:Name="PasswordBox"
                         Grid.Column="1"
                         Height="26"
                         Padding="6,2"
                         Background="#0B1E34"
                         BorderBrush="#30567E"
                         Foreground="#D8EBFF" />
        </Grid>

        <Border Grid.Row="5"
                BorderBrush="#1D3656"
                BorderThickness="1"
                CornerRadius="3"
                Background="#070C14"
                Padding="8,6">
            <StackPanel>
                <TextBlock x:Name="StoredPasswordText"
                           Foreground="#7F99B8"
                           FontSize="11"
                           Text="[i] Stored password: unknown" />
                <TextBlock x:Name="EnvironmentHintText"
                           Margin="0,4,0,0"
                           Foreground="#7F99B8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="[i] Distro is auto-selected from local WSL availability." />
                <TextBlock x:Name="StatusText"
                           Margin="0,6,0,0"
                           Foreground="#7F99B8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Text="[i] Save credentials, then use Verify to test sudo in WSL." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="Save_Click" />
            <Button x:Name="VerifyButton"
                    Content="Verify"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="Verify_Click" />
            <Button x:Name="ClearButton"
                    Content="Clear"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="Clear_Click" />
            <Button Content="Close"
                    Width="88"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
