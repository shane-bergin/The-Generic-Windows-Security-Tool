<UserControl x:Class="TGWST.App.Tabs.ScanTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="8">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="120"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
        <TextBlock Text="Scan type:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Width="180" SelectedIndex="{Binding ScanTypeIndex}" ToolTip="Quick: User folders. Standard: User profile. Full: All drives. YARA/IOC/LLM scripts">
            <ComboBoxItem Content="Quick"/>
            <ComboBoxItem Content="Standard"/>
            <ComboBoxItem Content="Full"/>
        </ComboBox>
        <CheckBox Content="Use LLM script analysis" Margin="8,0,0,0" IsChecked="{Binding UseLLM}"/>
        <Button Content="Scan" Click="Scan_Click" Margin="8,0,0,0" IsEnabled="{Binding !IsBusy}" ToolTip="Run selected scan"/>
        <Button Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" IsEnabled="{Binding IsBusy}" Visibility="{Binding ProgressVisible}" ToolTip="Cancel running scan"/>
        <ProgressBar Width="150"
                     Height="16"
                     Margin="8,0,0,0"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding Progress}"
                     Visibility="{Binding ProgressVisible}"
                     IsIndeterminate="{Binding ProgressIndeterminate}"/>
    </StackPanel>

    <DataGrid Grid.Row="1"
              ItemsSource="{Binding Results}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto"/>
            <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="*"/>
            <DataGridTextColumn Header="Family" Binding="{Binding ThreatFamily}" Width="*"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="3*"/>
            <DataGridTemplateColumn Header="LLM Analysis" Width="3*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                            <TextBlock Text="{Binding LLMAnalysis}" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>

        <GroupBox Header="Scan log" Grid.Row="2" Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox ItemsSource="{Binding LogLines}"
                         FontFamily="Consolas"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         IsHitTestVisible="False"/>
            </ScrollViewer>
        </GroupBox>

    <Grid Grid.Row="3" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
            <Button Content="Reload Feeds" Margin="8,0,0,0" Click="ReloadFeeds_Click" ToolTip="Reload YARA/IOC feeds"/>
            <TextBlock Text="{Binding ThreatFeeds.YaraRuleCount, StringFormat='YARA rules: {0}'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ThreatFeeds.IocBundleCount, StringFormat='IOC bundles: {0}'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ThreatFeeds.TotalFamilies, StringFormat='Families: {0}'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ThreatFeeds.LastReloadDisplay}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="LLM Settings" Margin="12,0,0,0" Click="LLMSettings_Click" ToolTip="Configure API provider and key for LLM analysis"/>
        </StackPanel>
    </Grid>
</Grid>
</UserControl>
