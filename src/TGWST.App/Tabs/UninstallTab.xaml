<UserControl x:Class="TGWST.App.Tabs.UninstallTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="8">
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="2*"/>
<RowDefinition Height="Auto"/>
<RowDefinition Height="2*"/>
<RowDefinition Height="Auto"/>
</Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
        <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0"/>
        <Button Content="Uninstall Selected" Click="Uninstall_Click" Margin="0,0,8,0" FontWeight="Bold"/>
        <TextBox x:Name="SearchBox" Width="200" Margin="8,0,0,0" VerticalContentAlignment="Center"
                 TextChanged="SearchBox_TextChanged" />
        <TextBlock Text="Search" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="Gray"/>
    </StackPanel>

    <TextBlock Grid.Row="1" Text="Installed Applications" FontWeight="Bold" Margin="0,0,0,4"/>

    <DataGrid x:Name="AppsGrid"
              Grid.Row="2"
              ItemsSource="{Binding Apps}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="2*"/>
            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="2*"/>
            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto"/>
            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="Auto"/>
            <DataGridTextColumn Header="Install Date" Binding="{Binding InstallDate}" Width="Auto"/>
        </DataGrid.Columns>
    </DataGrid>

    <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,8,0,8">
        <TextBlock Text="Leftovers Found After Uninstall" FontWeight="Bold" VerticalAlignment="Center"/>
        <Button Content="Select All" Click="SelectAll_Click" Margin="16,0,8,0" Padding="8,2"/>
        <Button Content="Deselect All" Click="DeselectAll_Click" Margin="0,0,8,0" Padding="8,2"/>
        <Button Content="Remove Selected" Click="RemoveLeftovers_Click" Margin="0,0,8,0" Padding="8,2" FontWeight="Bold"/>
        <CheckBox x:Name="DryRunCheck" Content="Dry run (no delete)" VerticalAlignment="Center" Margin="8,0,0,0"/>
    </StackPanel>

    <DataGrid x:Name="LeftoversGrid"
              Grid.Row="4"
              ItemsSource="{Binding Leftovers}"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              CanUserSortColumns="True">
        <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Delete?" Binding="{Binding Selected, Mode=TwoWay}" Width="60"/>
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*"/>
            <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*"/>
            <DataGridTextColumn Header="Details" Binding="{Binding MatchDetail}" Width="2*"/>
        </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="5" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{Binding Status}"
                   VerticalAlignment="Center"/>
        <ProgressBar Grid.Column="1"
                     x:Name="ScanProgress"
                     Width="200"
                     Height="20"
                     Visibility="Collapsed"
                     IsIndeterminate="True"
                     Margin="8,0,0,0"/>
    </Grid>
</Grid>
</UserControl>
