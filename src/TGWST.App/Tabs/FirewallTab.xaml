<UserControl x:Class="TGWST.App.Tabs.FirewallTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="Bold"/>
            <Button Content="Refresh" Margin="8,0,0,0" Click="Refresh_Click"/>
            <Button Content="Open Connections Monitor" Margin="8,0,0,0" Click="OpenConnections_Click" />
        </StackPanel>

        <DataGrid x:Name="ProfilesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="*"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="Auto"/>
                <DataGridTextColumn Header="Policy" Binding="{Binding Policy}" Width="2*"/>
                <DataGridCheckBoxColumn Header="Vulnerable" Binding="{Binding IsVulnerable}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="Red"/>
    </Grid>
</UserControl>
