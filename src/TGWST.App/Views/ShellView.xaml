<Window x:Class="TGWST.App.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - The Generic Windows Security Tool"
        Background="#0D0F12"
        Width="1200"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#0D0F12" />
        <SolidColorBrush x:Key="PanelBackground" Color="#0F1116" />
        <SolidColorBrush x:Key="Accent" Color="#5AA9FF" />
        <SolidColorBrush x:Key="AcronymExpanded" Color="#B384FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#D8E0E8" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B7A8A" />
        <SolidColorBrush x:Key="TextHint" Color="#8A9AAA" />
        <SolidColorBrush x:Key="Line" Color="#151A22" />
        <SolidColorBrush x:Key="Caret" Color="#FFD36A" />
        <SolidColorBrush x:Key="Warning" Color="#FFB366" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="16" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
            <TextBlock Text="TGWST" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" />
            <TextBlock Text=" / " FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="8,0,0,3" />
            <TextBlock Text="{Binding BreadcrumbPath}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
        </StackPanel>

        <!-- Quick menu -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding MenuEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4" MouseLeftButtonDown="OnMenuItemClick">
                            <!-- Main row: marker, index, title, subtitle, detail hint -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MenuMarker" Text=" " Width="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="MenuIndex" Text="{Binding IndexLabel}" Width="24" Foreground="{StaticResource TextHint}" />
                                <TextBlock x:Name="MenuTitle" Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                                <TextBlock x:Name="SubtitleSep" Text=" - " Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="MenuSubtitle" Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="DetailHint" Text=" [->]" FontSize="10" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Legacy detail (for items without RichDetail) -->
                            <TextBlock x:Name="MenuDetail"
                                       Text="{Binding Detail}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextHint}"
                                       Margin="38,2,0,0"
                                       Visibility="Collapsed" />

                            <!-- Level 1: Summary (RichDetail.Summary) -->
                            <TextBlock x:Name="SummaryLine"
                                       Text="{Binding RichDetail.Summary}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextHint}"
                                       Margin="38,2,0,0"
                                       Visibility="Collapsed" />

                            <!-- Level 2: Full detail expansion -->
                            <StackPanel x:Name="FullDetail" Margin="38,4,0,0" Visibility="Collapsed">
                                <!-- Changes section -->
                                <StackPanel x:Name="ChangesSection" Margin="0,0,0,4">
                                    <TextBlock Text="Changes:" Foreground="{StaticResource Accent}" FontSize="11" />
                                    <TextBlock Text="{Binding ChangesDisplay}" Foreground="{StaticResource TextHint}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Risks section -->
                                <StackPanel x:Name="RisksSection" Margin="0,0,0,4">
                                    <TextBlock Text="Risks:" Foreground="{StaticResource Warning}" FontSize="11" />
                                    <TextBlock Text="{Binding RisksDisplay}" Foreground="{StaticResource TextHint}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Rollback info -->
                                <TextBlock x:Name="RollbackLine" FontSize="11" Foreground="{StaticResource TextMuted}"
                                           Text="{Binding RichDetail.RollbackInfo, StringFormat='Rollback: {0}'}" Margin="0,0,0,2" />
                                <!-- Prerequisites -->
                                <TextBlock x:Name="PrereqLine" FontSize="11" Foreground="{StaticResource Warning}"
                                           Text="{Binding RichDetail.Prerequisites, StringFormat='Note: {0}'}" />
                            </StackPanel>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <!-- Selected state -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="MenuMarker" Property="Text" Value=">" />
                                <Setter TargetName="MenuMarker" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="MenuIndex" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="MenuTitle" Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                            <!-- Show detail hint for items with any detail -->
                            <DataTrigger Binding="{Binding HasAnyDetail}" Value="True">
                                <Setter TargetName="DetailHint" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Hide subtitle separator and hint when expanded -->
                            <DataTrigger Binding="{Binding ShowSummary}" Value="True">
                                <Setter TargetName="SubtitleSep" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MenuSubtitle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="DetailHint" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!-- Legacy detail display (no RichDetail) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowSummary}" Value="True" />
                                    <Condition Binding="{Binding HasRichDetail}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="MenuDetail" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <!-- Level 1: Summary visible (RichDetail) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowSummary}" Value="True" />
                                    <Condition Binding="{Binding HasRichDetail}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SummaryLine" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <!-- Level 2: Full detail visible -->
                            <DataTrigger Binding="{Binding ShowFullDetail}" Value="True">
                                <Setter TargetName="FullDetail" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Hide sections with empty content -->
                            <DataTrigger Binding="{Binding ChangesDisplay}" Value="">
                                <Setter TargetName="ChangesSection" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RisksDisplay}" Value="">
                                <Setter TargetName="RisksSection" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RichDetail.RollbackInfo}" Value="{x:Null}">
                                <Setter TargetName="RollbackLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RichDetail.Prerequisites}" Value="{x:Null}">
                                <Setter TargetName="PrereqLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Output scrollback -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Output}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,8"
                                   FontSize="14"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextWrapping="Wrap"
                                   xml:space="preserve"
                                   Text="{Binding DisplayText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcronymsExpanded}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AcronymExpanded}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Attached pane (tmux-style) -->
        <ContentControl Grid.Row="3"
                        Content="{Binding AttachedPane}"
                        Visibility="{Binding IsAttachedPaneVisible, Converter={StaticResource BoolToVisibility}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextHint}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Status}"
                                           Foreground="{StaticResource TextMuted}" />
                            </DockPanel>
                            <TextBlock Margin="0,6,0,6"
                                       FontSize="12"
                                       Foreground="{StaticResource Accent}"
                                       Text="{Binding DataContext.AttachedPaneClosePrompt, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding DataContext.IsAttachedPaneClosePromptVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Output}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,8"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       xml:space="preserve"
                                                       Text="{Binding DisplayText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAcronymsExpanded}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AcronymExpanded}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Prompt line -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" Padding="0,10,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding PromptPrefix}"
                           FontSize="16"
                           Foreground="{StaticResource TextHint}"
                           Margin="0,0,8,0" />
                <TextBox x:Name="CommandInput"
                         Text="{Binding CommandLine, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Foreground="{StaticResource TextPrimary}"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{StaticResource Caret}"
                         PreviewKeyDown="OnCommandInputPreviewKeyDown" />
            </DockPanel>
        </Border>

        <!-- Footer hints -->
        <TextBlock Grid.Row="5"
                   Margin="0,6,0,0"
                   FontSize="10"
                   Foreground="{StaticResource TextMuted}"
                   Text="{Binding FooterHints}" />
    </Grid>
</Window>
