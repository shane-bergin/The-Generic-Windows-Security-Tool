<Window x:Class="TGWST.App.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - The Generic Windows Security Tool"
        Background="#0B0D11"
        Width="1200"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        FontFamily="Cascadia Code, Cascadia Mono, Consolas"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <!-- Color Palette: Enhanced Modern Terminal Theme -->
        <SolidColorBrush x:Key="AppBackground" Color="#0A0E14" />
        <SolidColorBrush x:Key="PanelBackground" Color="#0D1117" />
        <SolidColorBrush x:Key="CardBackground" Color="#161B22" />
        <SolidColorBrush x:Key="Accent" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentBright" Color="#79C0FF" />
        <SolidColorBrush x:Key="AccentDim" Color="#388BFD" />
        <SolidColorBrush x:Key="AcronymExpanded" Color="#D2A8FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
        <SolidColorBrush x:Key="TextSecondary" Color="#C9D1D9" />
        <SolidColorBrush x:Key="TextMuted" Color="#8B949E" />
        <SolidColorBrush x:Key="TextDim" Color="#6E7681" />
        <SolidColorBrush x:Key="Line" Color="#21262D" />
        <SolidColorBrush x:Key="LineBright" Color="#30363D" />
        <SolidColorBrush x:Key="SelectionBackground" Color="#1C2128" />
        <SolidColorBrush x:Key="SelectionBorder" Color="#58A6FF" />
        <SolidColorBrush x:Key="LiveStatus" Color="#3FB950" />
        <SolidColorBrush x:Key="PausedStatus" Color="#D29922" />
        <SolidColorBrush x:Key="ErrorStatus" Color="#F85149" />
        <SolidColorBrush x:Key="Success" Color="#3FB950" />
        <SolidColorBrush x:Key="Warning" Color="#D29922" />
        <SolidColorBrush x:Key="Info" Color="#58A6FF" />
        <SolidColorBrush x:Key="Caret" Color="#D29922" />
        <Style x:Key="PaneStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Live">
                    <Setter Property="Foreground" Value="{StaticResource LiveStatus}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Running...">
                    <Setter Property="Foreground" Value="{StaticResource LiveStatus}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Starting">
                    <Setter Property="Foreground" Value="{StaticResource LiveStatus}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Monitoring...">
                    <Setter Property="Foreground" Value="{StaticResource LiveStatus}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="Foreground" Value="{StaticResource PausedStatus}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Foreground" Value="{StaticResource PausedStatus}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Closed">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource ErrorStatus}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource ErrorStatus}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="20,16" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with breadcrumb -->
        <Border Grid.Row="0" Margin="0,0,0,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="╔═╗" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="TGWST" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="│" FontSize="14" Foreground="{StaticResource Line}" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Text="{Binding BreadcrumbPath}" FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Quick menu -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding MenuEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                    <Border x:Name="MenuRow"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,4"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,0"
                            MouseLeftButtonDown="OnMenuItemClick">
                        <StackPanel>
                                <!-- Main row: marker, index, title, subtitle, detail hint -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MenuMarker"
                                               Text="  "
                                               Width="18"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="MenuIndex"
                                               Text="{Binding IndexLabel}"
                                               Width="28"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource TextDim}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="MenuTitle"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SubtitleSep"
                                               Text=" ─ "
                                               FontSize="13"
                                               Foreground="{StaticResource TextDim}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="MenuSubtitle"
                                               Text="{Binding Subtitle}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="DetailHint"
                                               Text=" ›"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>

                                <!-- Legacy detail (for items without RichDetail) -->
                                <TextBlock x:Name="MenuDetail"
                                           Text="{Binding Detail}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="46,6,0,0"
                                           LineHeight="18"
                                           Visibility="Collapsed" />

                                <!-- Level 1: Summary (RichDetail.Summary) -->
                                <TextBlock x:Name="SummaryLine"
                                           Text="{Binding RichDetail.Summary}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="18"
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="46,6,0,0"
                                           Visibility="Collapsed" />

                                <!-- Level 2: Full detail expansion -->
                                <Border x:Name="FullDetail"
                                        Margin="46,8,0,0"
                                        Padding="12,10"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <!-- Changes section -->
                                        <StackPanel x:Name="ChangesSection" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="✓" Foreground="{StaticResource Success}" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Changes" Foreground="{StaticResource Success}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ChangesDisplay}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11"
                                                       LineHeight="17"
                                                       Margin="18,0,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <!-- Risks section -->
                                        <StackPanel x:Name="RisksSection" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="⚠" Foreground="{StaticResource Warning}" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="Risks" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding RisksDisplay}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11"
                                                       LineHeight="17"
                                                       Margin="18,0,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <!-- Rollback info -->
                                        <StackPanel x:Name="RollbackSection" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↶" Foreground="{StaticResource Info}" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock x:Name="RollbackLine"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Text="{Binding RichDetail.RollbackInfo, StringFormat='Rollback: {0}'}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Prerequisites -->
                                        <StackPanel x:Name="PrereqSection">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="ℹ" Foreground="{StaticResource Info}" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock x:Name="PrereqLine"
                                                           FontSize="11"
                                                           LineHeight="17"
                                                           Foreground="{StaticResource TextMuted}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding RichDetail.Prerequisites, StringFormat='Note: {0}'}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- Selected state -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="MenuMarker" Property="Text" Value="▶" />
                                <Setter TargetName="MenuMarker" Property="Foreground" Value="{StaticResource Accent}" />
                                <Setter TargetName="MenuIndex" Property="Foreground" Value="{StaticResource AccentBright}" />
                                <Setter TargetName="MenuTitle" Property="Foreground" Value="{StaticResource AccentBright}" />
                                <Setter TargetName="MenuRow" Property="Background" Value="{StaticResource SelectionBackground}" />
                                <Setter TargetName="MenuRow" Property="BorderBrush" Value="{StaticResource SelectionBorder}" />
                                <Setter TargetName="MenuRow" Property="BorderThickness" Value="3,0,0,0" />
                            </DataTrigger>
                            <!-- Show detail hint for items with any detail -->
                            <DataTrigger Binding="{Binding HasAnyDetail}" Value="True">
                                <Setter TargetName="DetailHint" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Hide subtitle separator and hint when expanded -->
                            <DataTrigger Binding="{Binding ShowSummary}" Value="True">
                                <Setter TargetName="SubtitleSep" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MenuSubtitle" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="DetailHint" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!-- Legacy detail display (no RichDetail) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowSummary}" Value="True" />
                                    <Condition Binding="{Binding HasRichDetail}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="MenuDetail" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <!-- Level 1: Summary visible (RichDetail) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowSummary}" Value="True" />
                                    <Condition Binding="{Binding HasRichDetail}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SummaryLine" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <!-- Level 2: Full detail visible -->
                            <DataTrigger Binding="{Binding ShowFullDetail}" Value="True">
                                <Setter TargetName="FullDetail" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Hide sections with empty content -->
                            <DataTrigger Binding="{Binding ChangesDisplay}" Value="">
                                <Setter TargetName="ChangesSection" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RisksDisplay}" Value="">
                                <Setter TargetName="RisksSection" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RichDetail.RollbackInfo}" Value="{x:Null}">
                                <Setter TargetName="RollbackSection" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RichDetail.Prerequisites}" Value="{x:Null}">
                                <Setter TargetName="PrereqSection" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Output scrollback -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,12">
            <ScrollViewer x:Name="OutputScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True"
                          IsDeferredScrollingEnabled="True"
                          Loaded="OnOutputScrollLoaded"
                          Unloaded="OnOutputScrollUnloaded">
                <ItemsControl ItemsSource="{Binding Output}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,0,0,10"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       xml:space="preserve"
                                       Text="{Binding DisplayText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAcronymsExpanded}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AcronymExpanded}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Attached pane (tmux-style) -->
        <ContentControl Grid.Row="3"
                        Content="{Binding AttachedPane}"
                        Visibility="{Binding IsAttachedPaneVisible, Converter={StaticResource BoolToVisibility}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource LineBright}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Background="{StaticResource CardBackground}"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Pane header -->
                            <Border BorderBrush="{StaticResource Line}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,8"
                                    Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◆" FontSize="13" Foreground="{StaticResource Accent}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="●"
                                                   FontSize="11"
                                                   Margin="0,0,6,0"
                                                   Style="{StaticResource PaneStatusStyle}" />
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Style="{StaticResource PaneStatusStyle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Close prompt -->
                            <Border Background="{StaticResource SelectionBackground}"
                                    BorderBrush="{StaticResource Info}"
                                    BorderThickness="2,0,0,0"
                                    Padding="10,6"
                                    Margin="0,0,0,10"
                                    CornerRadius="3"
                                    Visibility="{Binding DataContext.IsAttachedPaneClosePromptVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ℹ" FontSize="12" Foreground="{StaticResource Info}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DataContext.AttachedPaneClosePrompt, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="12"
                                               Foreground="{StaticResource Info}" />
                                </StackPanel>
                            </Border>

                            <!-- Pane content -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="300"
                                          CanContentScroll="True"
                                          IsDeferredScrollingEnabled="True"
                                          Focusable="True"
                                          Loaded="OnAttachedScrollLoaded"
                                          Unloaded="OnAttachedScrollUnloaded">
                                <ItemsControl ItemsSource="{Binding Output}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,8"
                                                       FontSize="12"
                                                       LineHeight="18"
                                                       TextWrapping="Wrap"
                                                       xml:space="preserve"
                                                       Text="{Binding DisplayText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAcronymsExpanded}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AcronymExpanded}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- Prompt line -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource LineBright}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{StaticResource PanelBackground}"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding PromptPrefix}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource Accent}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBox x:Name="CommandInput"
                         Text="{Binding CommandLine, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Foreground="{StaticResource TextPrimary}"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{StaticResource Caret}"
                         VerticalAlignment="Center"
                         PreviewKeyDown="OnCommandInputPreviewKeyDown" />
            </DockPanel>
        </Border>

        <!-- Footer hints -->
        <Border Grid.Row="5"
                Margin="0,10,0,0"
                Padding="12,8"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock FontSize="10"
                       LineHeight="15"
                       Foreground="{StaticResource TextMuted}"
                       Text="{Binding FooterHints}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
