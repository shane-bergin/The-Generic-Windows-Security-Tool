<Window x:Class="TGWST.App.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - Security Terminal"
        Icon="/Assets/generic_windows_security_tool_icon.png"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="680"
        Background="#1A1F2B"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Aliased"
        TextOptions.TextHintingMode="Fixed"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1A1F2B" />
        <SolidColorBrush x:Key="Panel" Color="#21293A" />
        <SolidColorBrush x:Key="Panel2" Color="#1D2535" />
        <SolidColorBrush x:Key="Line" Color="#3C4C68" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DEE7F6" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A4C1" />
        <SolidColorBrush x:Key="Green" Color="#8ED26D" />
        <SolidColorBrush x:Key="Amber" Color="#D9BA70" />
        <SolidColorBrush x:Key="Red" Color="#E16E74" />
        <SolidColorBrush x:Key="Blue" Color="#64A7E2" />
        <SolidColorBrush x:Key="Cyan" Color="#7EC7FF" />
        <SolidColorBrush x:Key="Magenta" Color="#A89AE0" />
        <SolidColorBrush x:Key="Caret" Color="#7EC7FF" />

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#27324A" />
            <Setter Property="BorderBrush" Value="#4A5B79" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#30405B" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#86B6E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#24334A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickMenuComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="188" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#27324A" />
            <Setter Property="BorderBrush" Value="#4A5B79" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="4,1" />
        </Style>

        <Style x:Key="QuickMenuItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#27324A" />
        </Style>

        <Style x:Key="PaneStatusStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Live">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Running...">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Starting">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Monitoring...">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Paused">
                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Foreground" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="8" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="8,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <DockPanel LastChildFill="True">
                        <Border Width="46"
                                Height="46"
                                Margin="0,0,8,0"
                                BorderBrush="#4F6483"
                                BorderThickness="1"
                                Background="#243249">
                            <Image Source="/Assets/TGWST.png"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel>
                            <TextBlock FontSize="10" Foreground="{StaticResource Cyan}" xml:space="preserve"
                                       Text="┌─ THE GENERIC WINDOWS SECURITY TOOL ─────────────────────────────────────────────────────────┐" />
                            <TextBlock FontSize="10" Foreground="{StaticResource Blue}" xml:space="preserve"
                                       Text="│ security terminal | pipelines: windows11(native) + wsl2(ubuntu/bash) | mode: administrator │" />
                            <TextBlock FontSize="10" Foreground="{StaticResource Cyan}" xml:space="preserve"
                                       Text="└───────────────────────────────────────────────────────────────────────────────────────────────┘" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Bottom"
                           FontSize="10"
                           Foreground="{StaticResource TextMuted}"
                           Text="{Binding BreadcrumbPath, StringFormat='path : {0}'}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,6"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel2}"
                Padding="8,4">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{StaticResource Green}"
                           Text="[ACTIONS]" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{StaticResource Blue}"
                               Text="[VIEWS/TOOLS]" />

                    <ComboBox x:Name="ViewsMenu"
                              Style="{StaticResource QuickMenuComboStyle}"
                              SelectedIndex="0"
                              SelectionChanged="OnQuickMenuSelectionChanged">
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Content="[VIEWS]" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__open_bootstrap_wizard" Content="Bootstrap Wizard" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__open_wsl_credentials" Content="WSL Credentials" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__open_connections" Content="Connections Window" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__focus_pane" Content="Focus Attached Pane" />
                    </ComboBox>

                    <ComboBox x:Name="ToolsMenu"
                              Style="{StaticResource QuickMenuComboStyle}"
                              SelectedIndex="0"
                              SelectionChanged="OnQuickMenuSelectionChanged">
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Content="[TOOLS]" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__open_network_ops" Content="Network Operations Window" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__open_maintenance_ops" Content="Maintenance Operations Window" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__explain_last" Content="Explain Last Output (F3)" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="__summarize_output" Content="Summarize Output (F4)" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="network board" Content="Network Feature Board" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="network setup" Content="Network Setup Check" />
                        <ComboBoxItem Style="{StaticResource QuickMenuItemStyle}" Tag="network live" Content="Open Live Monitor Pane" />
                    </ComboBox>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="__open_network_ops" Content="STATUS" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="__open_bootstrap_wizard" Content="SETUP" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="network quick" Content="QUICK" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="network live" Content="LIVE" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="network feature enable hybrid" Content="HYBRID ON" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="network feature disable hybrid" Content="HYBRID OFF" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="network pihole status" Content="PIHOLE" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="network pihole top" Content="TOP-BLOCK" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="__open_maintenance_ops" Content="MAINT" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="__open_wsl_credentials" Content="WSL-CREDS" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="help" Content="HELP" />
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionClick" Tag="clear" Content="CLEAR" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="278" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,6,0"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1"
                    Background="{StaticResource Panel}"
                    Padding="8,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="0,0,0,4"
                               FontSize="10"
                               Foreground="{StaticResource Blue}"
                               Text="[MODULE NAV] click to select, double-click to execute" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MenuEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="MenuRow"
                                            Margin="0,0,0,2"
                                            Padding="6,3"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            MouseLeftButtonDown="OnMenuItemClick">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="MenuMarker" Width="18" FontSize="10" Foreground="{StaticResource TextMuted}" Text="[ ]" />
                                                <TextBlock Width="24" FontSize="10" Foreground="{StaticResource TextMuted}" Text="{Binding IndexLabel}" />
                                                <TextBlock x:Name="MenuTitle" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Title}" />
                                            </StackPanel>
                                            <TextBlock Margin="42,1,0,0"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMuted}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Subtitle}" />
                                            <TextBlock x:Name="SummaryLine"
                                                       Margin="42,1,0,0"
                                                       FontSize="9"
                                                       Foreground="{StaticResource Magenta}"
                                                       TextWrapping="Wrap"
                                                       Visibility="Collapsed"
                                                       Text="{Binding RichDetail.Summary}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="MenuRow" Property="Background" Value="#2A3851" />
                                            <Setter TargetName="MenuRow" Property="BorderBrush" Value="#84B8F1" />
                                            <Setter TargetName="MenuMarker" Property="Text" Value="[>]" />
                                            <Setter TargetName="MenuMarker" Property="Foreground" Value="{StaticResource Green}" />
                                            <Setter TargetName="MenuTitle" Property="Foreground" Value="{StaticResource Cyan}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ShowSummary}" Value="True">
                                            <Setter TargetName="SummaryLine" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="1"
                        Background="{StaticResource Panel}"
                        Padding="6,4">
                    <ScrollViewer x:Name="OutputScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True"
                                  IsDeferredScrollingEnabled="True"
                                  Loaded="OnOutputScrollLoaded"
                                  Unloaded="OnOutputScrollUnloaded">
                        <ItemsControl ItemsSource="{Binding Output}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,0"
                                               FontSize="10"
                                               LineHeight="10.5"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextWrapping="Wrap"
                                               xml:space="preserve"
                                               Text="{Binding DisplayText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ColorTag}" Value="success">
                                                        <Setter Property="Foreground" Value="{StaticResource Green}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ColorTag}" Value="error">
                                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ColorTag}" Value="warning">
                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ColorTag}" Value="info">
                                                        <Setter Property="Foreground" Value="{StaticResource Blue}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ColorTag}" Value="accent">
                                                        <Setter Property="Foreground" Value="{StaticResource Cyan}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAcronymsExpanded}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Magenta}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <ContentControl Grid.Row="1"
                                Margin="0,6,0,0"
                                Content="{Binding AttachedPane}"
                                Visibility="{Binding IsAttachedPaneVisible, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}"
                                    BorderThickness="1"
                                    Background="{StaticResource Panel2}"
                                    Padding="6,4">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" FontSize="10" Foreground="{StaticResource Blue}" Text="[ATTACHED PANE] " />
                                        <TextBlock DockPanel.Dock="Left" FontSize="10" Foreground="{StaticResource TextPrimary}" Text="{Binding Title}" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="10" Style="{StaticResource PaneStatusStyle}" Text="{Binding Status}" />
                                    </DockPanel>

                                    <Border Margin="0,0,0,4"
                                            Padding="6,2"
                                            Background="#263850"
                                            BorderBrush="#4B6180"
                                            BorderThickness="1"
                                            Visibility="{Binding DataContext.IsAttachedPaneClosePromptVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="9"
                                                   Foreground="{StaticResource Cyan}"
                                                   Text="{Binding DataContext.AttachedPaneClosePrompt, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="170"
                                                  CanContentScroll="True"
                                                  IsDeferredScrollingEnabled="True"
                                                  Focusable="True"
                                                  Loaded="OnAttachedScrollLoaded"
                                                  Unloaded="OnAttachedScrollUnloaded">
                                        <ItemsControl ItemsSource="{Binding Output}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,0"
                                                               FontSize="10"
                                                               LineHeight="10.5"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               TextWrapping="Wrap"
                                                               xml:space="preserve"
                                                               Text="{Binding DisplayText}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Border Margin="0,4,0,0"
                                            Padding="4,3"
                                            Background="#1A2232"
                                            BorderBrush="#3F5472"
                                            BorderThickness="1"
                                            Visibility="{Binding HasInteractiveEndpoints, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,3" LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="9"
                                                           Foreground="{StaticResource Cyan}"
                                                           Text="[ENDPOINT FOCUS] click to select, double-click or Inspect for details" />
                                                <Border DockPanel.Dock="Right"
                                                        Padding="4,1"
                                                        Background="#243249"
                                                        BorderBrush="#4F6483"
                                                        BorderThickness="1">
                                                    <TextBox Width="210"
                                                             FontSize="9"
                                                             Foreground="{StaticResource TextPrimary}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             CaretBrush="{StaticResource Cyan}"
                                                             Text="{Binding EndpointFilter, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Filter: process / ip / host / pid" />
                                                </Border>
                                            </DockPanel>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          MaxHeight="120">
                                                <ItemsControl ItemsSource="{Binding InteractiveEndpoints}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,2"
                                                                    Padding="4,2"
                                                                    BorderBrush="#4F6483"
                                                                    BorderThickness="1"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="OnEndpointRowClick">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#243249" />
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#2D3F59" />
                                                                                <Setter Property="BorderBrush" Value="#82B7EF" />
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="#304767" />
                                                                                <Setter Property="BorderBrush" Value="#9AD1FF" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <DockPanel LastChildFill="False">
                                                                        <TextBlock FontSize="10"
                                                                                   Foreground="{StaticResource TextPrimary}"
                                                                                   Text="{Binding EndpointDisplay}" />

                                                                        <TextBlock DockPanel.Dock="Right"
                                                                                   Margin="6,0,0,0"
                                                                                   FontSize="9"
                                                                                   Foreground="{StaticResource Blue}"
                                                                                   Text="{Binding TotalBytesDisplay}" />

                                                                        <Border DockPanel.Dock="Right"
                                                                                Margin="6,0,0,0"
                                                                                Padding="4,0"
                                                                                BorderBrush="#2B344A"
                                                                                BorderThickness="1"
                                                                                CornerRadius="2">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#354766" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding RiskTag}" Value="high">
                                                                                            <Setter Property="Background" Value="#7B2D39" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding RiskTag}" Value="med">
                                                                                            <Setter Property="Background" Value="#7A5A2E" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding RiskTag}" Value="low">
                                                                                            <Setter Property="Background" Value="#2E6548" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock FontSize="9"
                                                                                       Foreground="{StaticResource TextPrimary}"
                                                                                       Text="{Binding RiskToken}" />
                                                                        </Border>
                                                                    </DockPanel>

                                                                    <TextBlock Margin="0,1,0,0"
                                                                               FontSize="9"
                                                                               Foreground="{StaticResource TextMuted}"
                                                                               Text="{Binding EndpointSubline}" />

                                                                    <DockPanel Margin="0,1,0,0" LastChildFill="False">
                                                                        <TextBlock DockPanel.Dock="Left"
                                                                                   FontSize="8"
                                                                                   Foreground="{StaticResource Green}"
                                                                                   Text="{Binding ThroughputSparkline}" />
                                                                        <Button DockPanel.Dock="Right"
                                                                                Margin="4,0,0,0"
                                                                                Padding="4,0"
                                                                                FontSize="8"
                                                                                Content="Whois"
                                                                                Click="OnEndpointWhoisClick" />
                                                                        <Button DockPanel.Dock="Right"
                                                                                Margin="4,0,0,0"
                                                                                Padding="4,0"
                                                                                FontSize="8"
                                                                                Content="Copy IP"
                                                                                Click="OnEndpointCopyIpClick" />
                                                                        <Button DockPanel.Dock="Right"
                                                                                Margin="4,0,0,0"
                                                                                Padding="4,0"
                                                                                FontSize="8"
                                                                                Content="Inspect"
                                                                                Click="OnEndpointInspectClick" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel2}"
                Padding="6,3">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding PromptPrefix}"
                           Margin="0,0,7,0"
                           Foreground="{StaticResource Green}"
                           FontSize="10"
                           VerticalAlignment="Center" />
                <TextBox x:Name="CommandInput"
                         Text="{Binding CommandLine, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11"
                         Foreground="{StaticResource TextPrimary}"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{StaticResource Caret}"
                         VerticalAlignment="Center"
                         PreviewKeyDown="OnCommandInputPreviewKeyDown" />
            </DockPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="0,6,0,0"
                BorderBrush="{StaticResource Line}"
                BorderThickness="1"
                Background="{StaticResource Panel}"
                Padding="6,3">
            <TextBlock FontSize="9"
                       Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap"
                       Text="{Binding FooterHints}" />
        </Border>
    </Grid>
</Window>
