<Window x:Class="TGWST.App.Views.ProgressView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TGWST - Task Output"
        Background="#0D0F12"
        Width="980"
        Height="640"
        MinWidth="820"
        MinHeight="540"
        FontFamily="Cascadia Mono, Consolas"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#0D0F12" />
        <SolidColorBrush x:Key="Accent" Color="#5AA9FF" />
        <SolidColorBrush x:Key="AcronymExpanded" Color="#B384FF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF5" />
        <SolidColorBrush x:Key="TextMuted" Color="#9AA7B5" />
        <SolidColorBrush x:Key="TextHint" Color="#C9D4E3" />
        <SolidColorBrush x:Key="Line" Color="#1B2633" />
    </Window.Resources>

    <Grid Margin="24" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" Foreground="{StaticResource TextHint}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource TextMuted}" />
            </DockPanel>
            <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Output}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,10"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   xml:space="preserve"
                                   Text="{Binding DisplayText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAcronymsExpanded}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AcronymExpanded}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
