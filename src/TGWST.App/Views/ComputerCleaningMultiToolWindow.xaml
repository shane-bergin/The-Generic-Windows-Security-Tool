<Window x:Class="TGWST.App.Views.ComputerCleaningMultiToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computer Cleaning Multi-Tool"
        Icon="/Assets/generic_windows_security_tool_icon.png"
        Width="1260"
        Height="780"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BlackBrush}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AsciiBorderStyle}" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Foreground="{StaticResource CyanBrush}" Text="+-- COMPUTER CLEANING MULTI-TOOL ------------------------------------------+" />
                    <TextBlock Foreground="{StaticResource LightGrayBrush}" Text="| app inventory | uninstall launcher | registry components | appdata/temp cleanup | risk warnings |" />
                    <TextBlock Foreground="{StaticResource CyanBrush}" Text="+--------------------------------------------------------------------------+" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource LightGrayBrush}"
                           Text="{Binding Status}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AsciiBorderStyle}" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBox Width="260"
                                 Margin="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter installed app inventory by app name or publisher." />
                        <Button Margin="0,0,8,0" Command="{Binding ScanAppsCommand}" Content="[ SCAN APPS ]" />
                        <Button Margin="0,0,8,0" Command="{Binding UninstallSelectedCommand}" Content="[ UNINSTALL SELECTED ]" />
                        <Button Margin="0,0,8,0" Command="{Binding FindResidueCommand}" Content="[ FIND RESIDUE ]" />
                        <Button Margin="0,0,8,0" Command="{Binding CleanSafeResidueCommand}" Content="[ CLEAN SAFE RESIDUE ]" />
                        <Button Command="{Binding RefreshRisksCommand}" Content="[ REFRESH RISKS ]" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Foreground="{StaticResource DimGrayBrush}"
                               VerticalAlignment="Center"
                               Text="Registry rows are inspection-only; cleanup deletes safe AppData/Temp targets after confirmation." />
                </DockPanel>
            </Border>

            <TabControl Grid.Row="1">
                <TabItem Header="Apps">
                    <Border Style="{StaticResource AsciiBorderStyle}" Margin="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Foreground="{StaticResource CyanBrush}"
                                       Margin="0,0,0,8"
                                       Text="[INSTALLED APP INVENTORY]" />
                            <DataGrid ItemsSource="{Binding InstalledApps}"
                                      SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="80" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding DisplayVersion, Mode=OneWay}" Width="120" />
                                    <DataGridTextColumn Header="Publisher" Binding="{Binding DisplayPublisher, Mode=OneWay}" Width="180" />
                                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="80" />
                                    <DataGridTextColumn Header="Concern" Binding="{Binding Concern}" Width="2*" />
                                    <DataGridTextColumn Header="Install Location" Binding="{Binding InstallLocation}" Width="2*" />
                                    <DataGridTextColumn Header="Registry Key" Binding="{Binding RegistryKey}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Residue">
                    <Border Style="{StaticResource AsciiBorderStyle}" Margin="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Foreground="{StaticResource CyanBrush}"
                                       Margin="0,0,0,8"
                                       Text="[REGISTRY COMPONENTS / APPDATA / TEMP]" />
                            <DataGrid ItemsSource="{Binding Residues}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Clean" Binding="{Binding SafeText, Mode=OneWay}" Width="80" />
                                    <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="90" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                                    <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="2*" />
                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Risks">
                    <Border Style="{StaticResource AsciiBorderStyle}" Margin="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Foreground="{StaticResource CyanBrush}"
                                       Margin="0,0,0,8"
                                       Text="[SECURITY WARNINGS FOR CURRENT SETUP]" />
                            <DataGrid ItemsSource="{Binding Risks}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100" />
                                    <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="180" />
                                    <DataGridTextColumn Header="Concern" Binding="{Binding Concern}" Width="2*" />
                                    <DataGridTextColumn Header="Potential Exploit" Binding="{Binding PotentialExploit}" Width="3*" />
                                    <DataGridTextColumn Header="Recommended Action" Binding="{Binding RecommendedAction}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AsciiBorderStyle}" Margin="0,10,0,0" Padding="8">
            <TextBlock Foreground="{StaticResource LightGrayBrush}" Text="{Binding Status}" />
        </Border>
    </Grid>
</Window>
