<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TGWST</AssemblyName>
    <StartupObject>TGWST.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TGWST.Core\TGWST.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\generic_windows_security_tool_icon.png" />
    <Resource Include="Assets\TGWST.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <Target Name="GenerateTGWSTBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <TGWSTBuildInfoPath>$(IntermediateOutputPath)build-info.txt</TGWSTBuildInfoPath>
      <TGWSTBuildTimeUtc>$([System.DateTime]::UtcNow.ToString("O"))</TGWSTBuildTimeUtc>
    </PropertyGroup>

    <ItemGroup>
      <TGWSTBuildInfoLine Include="Version=$(TGWSTVersion)" />
      <TGWSTBuildInfoLine Include="Commit=$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
      <TGWSTBuildInfoLine Include="BuildTimeUtc=$(TGWSTBuildTimeUtc)" />
    </ItemGroup>

    <WriteLinesToFile File="$(TGWSTBuildInfoPath)"
                      Lines="@(TGWSTBuildInfoLine)"
                      Overwrite="true"
                      Encoding="UTF-8" />

    <ItemGroup>
      <None Include="$(TGWSTBuildInfoPath)"
            Link="build-info.txt"
            CopyToOutputDirectory="Always"
            CopyToPublishDirectory="Always"
            Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="CopyTGWSTBuildInfoToOutput" AfterTargets="Build"
          Condition="Exists('$(TGWSTBuildInfoPath)')">
    <Copy SourceFiles="$(TGWSTBuildInfoPath)"
          DestinationFiles="$(OutDir)build-info.txt"
          SkipUnchangedFiles="false" />
  </Target>

  <Target Name="CopyTGWSTBuildInfoToPublish" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and Exists('$(TGWSTBuildInfoPath)')">
    <Copy SourceFiles="$(TGWSTBuildInfoPath)"
          DestinationFiles="$(PublishDir)build-info.txt"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
