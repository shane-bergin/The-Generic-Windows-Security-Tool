<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BlackColor">#000000</Color>
    <Color x:Key="NavyColor">#050B14</Color>
    <Color x:Key="PanelColor">#07111F</Color>
    <Color x:Key="PanelAltColor">#0A1728</Color>
    <Color x:Key="CyanColor">#00D4FF</Color>
    <Color x:Key="RedColor">#FF3B3B</Color>
    <Color x:Key="OrangeColor">#FF9F1C</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="LightGrayColor">#CCCCCC</Color>
    <Color x:Key="DimGrayColor">#7A7A7A</Color>
    <Color x:Key="OverlayColor">#DD000000</Color>

    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource BlackColor}" />
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGrayColor}" />
    <SolidColorBrush x:Key="DimGrayBrush" Color="{StaticResource DimGrayColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="{StaticResource BlackColor}" />
    <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="AppPanelBackgroundAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource LightGrayColor}" />
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource DimGrayColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="AppErrorBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="AppButtonHoverBackgroundBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="AppButtonPressedBackgroundBrush" Color="{StaticResource PanelColor}" />

    <Style x:Key="AsciiBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BlackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PanelAltBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource OrangeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DimGrayBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource DimGrayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource BlackBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource LightGrayBrush}" />
        <Setter Property="Background" Value="{StaticResource BlackBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,0"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,4,0">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource NavyBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BlackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource BlackBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource NavyBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelAltBrush}" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    </Style>

    <Style TargetType="RichTextBox">
        <Setter Property="Background" Value="{StaticResource BlackBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LightGrayBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="16" />
    </Style>
</ResourceDictionary>
